---
import AppWindow from '../components/AppWindow.astro';
import DownloadButton from '../components/DownloadButton.astro';
import DownloadSection from '../components/DownloadSection.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import FeatureTabs, {
  type TabbedFeature,
} from '../components/FeatureTabs.astro';
import Icon from '../components/Icon.astro';
import PageSection from '../components/PageSection.astro';
import ShowcaseGallery, {
  type ShowcaseItem,
} from '../components/ShowcaseGallery.astro';
import ViewGallery, { type GalleryView } from '../components/ViewGallery.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const spaces: ShowcaseItem[] = [
  {
    title: 'Project hub',
    description:
      'A board of tasks beside the project brief, with notes and deadlines a tab away.',
  },
  {
    title: 'Media library',
    description:
      'Tabs for films, shows, and books, each a wall of covers with your ratings on them.',
  },
  {
    title: 'Studies',
    description:
      "A term's courses down one side, with lectures, readings, and assignments beside them.",
  },
  {
    title: 'Research desk',
    description:
      'Sources and quotes next to a live web page, so you can read and write in one place.',
  },
  {
    title: 'Kitchen',
    description:
      "Recipes as a gallery, the week's meals on a board, and the shopping list beside them.",
  },
  {
    title: 'Travel planner',
    description:
      'Bookings and places to see on a live map, with a tab for each day of the trip.',
  },
  {
    title: 'Personal dashboard',
    description:
      "Today's tasks, this week's meals, and your recent notes, so you land somewhere useful.",
  },
  {
    title: 'Job search',
    description:
      'Applications on a board, with interviews, contacts, and each posting alongside.',
  },
];

const views: GalleryView[] = [
  {
    title: 'Table',
    description: 'Rows and columns, with every property in view at once.',
  },
  {
    title: 'Gallery',
    description: 'A grid of cards, sized and spaced however you like.',
  },
  {
    title: 'Notebook',
    description: "A list of entries beside the selected one's full page.",
  },
  {
    title: 'Board',
    description: 'Columns you arrange by hand, dragging entries between them.',
  },
  {
    title: 'Canvas',
    description: 'A freeform space where entries sit wherever you put them.',
  },
  {
    title: 'Kanban',
    description: 'Columns driven by a property, so entries move as it changes.',
  },
];

const databaseFeatures: TabbedFeature[] = [
  {
    id: 'properties',
    title: 'Properties',
    description:
      'Give every entry the same typed fields, from text, dates, and numbers to select options, files, links between databases, and plenty more.',
    icon: 'list',
  },
  {
    id: 'templates',
    title: 'Entry templates',
    description:
      'Set up templates to quickly create repetitive entries with their properties and content pre-filled.',
    icon: 'copy',
  },
  {
    id: 'automations',
    title: 'Automations',
    description:
      'Set rules that keep entries in step with each other, such as marking a project complete once every task linked to it is done.',
    icon: 'workflow',
  },
  {
    id: 'files',
    title: 'Choose your format',
    description:
      'Entries are plain Markdown files by default, and any database can store them as JSON or YAML instead.',
    icon: 'file-text',
  },
];
---

<BaseLayout
  title="MindDrop"
  description="Organise your projects, studies, research, and ideas into databases built from plain Markdown files."
>
  <section class="page hero">
    <h1 class="hero-title">Your mind's visual workspace</h1>

    <p class="hero-lede">
      Organise your projects, studies, research, and ideas into databases built
      from plain Markdown files.
    </p>

    <div class="hero-action">
      <DownloadButton />
    </div>

    <p class="hero-licence">
      MindDrop is free and <a href="https://github.com/coniel/minddrop"
        >open source</a
      >.
    </p>

    <div class="hero-principles">
      <FeatureGrid>
        <article class="principle">
          <h2 class="principle-title">
            <Icon name="database" />
            Databases
          </h2>

          <p class="principle-description">
            All your content lives in databases, where you define the properties
            every entry shares.
          </p>
        </article>

        <article class="principle">
          <h2 class="principle-title">
            <Icon name="file-text" />
            Plain files
          </h2>

          <p class="principle-description">
            Every entry is a plain Markdown file, stored in a folder on your
            computer and readable in any editor.
          </p>
        </article>

        <article class="principle">
          <h2 class="principle-title">
            <Icon name="palette" />
            Design studio
          </h2>

          <p class="principle-description">
            Give each database a unique design to match its content, built in a
            drag-and-drop design tool.
          </p>
        </article>
      </FeatureGrid>
    </div>

    <div class="hero-media">
      <AppWindow />
    </div>
  </section>

  <PageSection
    id="databases"
    title="Databases"
    description="All your content lives in a database: a folder of entries that share the properties you define. The folder is a real folder on your disk, and each entry is a real file inside it."
  >
    <FeatureTabs name="databases" features={databaseFeatures} />

    <div class="gathering">
      <h3 class="gathering-title">Collections and queries</h3>

      <p class="gathering-description">
        Two ways of gathering entries into a view: pick them yourself, or
        describe what you are after and let the rules find them.
      </p>

      <div class="groupings">
        <article class="grouping">
          <h4 class="grouping-title">
            <Icon name="bookmark" />
            Collections
          </h4>

          <p class="grouping-description">
            Gather entries from any database into a list you curate by hand,
            bringing everything about one project or theme together wherever it
            happens to live.
          </p>

          <div class="grouping-media">
            <AppWindow />
          </div>
        </article>

        <article class="grouping">
          <h4 class="grouping-title">
            <Icon name="filter" />
            Queries
          </h4>

          <p class="grouping-description">
            Describe the entries you are after with rules that span as many
            databases as you need. The result keeps itself up to date as entries
            come and go.
          </p>

          <div class="grouping-media">
            <AppWindow />
          </div>
        </article>
      </div>
    </div>
  </PageSection>

  <PageSection
    id="design-studio"
    title="Design studio"
    description="A drag-and-drop canvas for designing how entries look when displayed as cards, rows, or a full page."
  >
    <AppWindow />
  </PageSection>

  <PageSection
    id="views"
    title="Views"
    description="Each view shows the entries in a collection, query, or entire database, arranged in whichever way suits them."
  >
    <ViewGallery views={views} />
  </PageSection>

  <PageSection
    id="spaces"
    title="Spaces"
    description="Build spaces combining multiple views with a custom design, around a project, a topic, or an idea."
  >
    <ShowcaseGallery name="spaces" items={spaces} />
  </PageSection>

  <DownloadSection />
</BaseLayout>

<style>
  .hero {
    padding-block-start: var(--space-8);
    text-align: center;
  }

  .hero-title {
    font-size: var(--step-4);
  }

  .hero-lede {
    max-width: var(--measure);
    margin-block-start: var(--space-5);
    margin-inline: auto;
    font-size: var(--step-1);
    color: var(--ink-muted);
  }

  .hero-action {
    margin-block-start: var(--space-6);
  }

  .hero-licence {
    margin-block-start: var(--space-5);
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  /*
   * Paired with the gap above the licence line, so dropping that line lower
   * leaves the distance from button to cards unchanged.
   */
  .hero-principles {
    margin-block-start: calc(var(--space-8) - var(--space-3));
  }

  .principle {
    padding: var(--space-4);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
    text-align: start;
  }

  .principle-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--step-0);
  }

  .principle-title :global(.icon) {
    color: var(--ink-muted);
  }

  .principle-description {
    margin-block-start: var(--space-2);
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  /* The screenshot belongs with the blocks above it, so it sits close */
  .hero-media {
    margin-block-start: var(--space-6);
  }

  /* A sub-section of databases, so it sits closer than the sections do */
  .gathering {
    margin-block-start: var(--space-8);
  }

  .gathering-title {
    font-size: var(--step-2);
  }

  .gathering-description {
    max-width: var(--measure);
    margin-block: var(--space-4) var(--space-6);
    color: var(--ink-muted);
  }

  /* The two ways of gathering entries, given a card each */
  .groupings {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .grouping {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    border: 1px solid var(--rule);
    border-radius: var(--radius-xl);
    background: var(--paper-raised);
  }

  .grouping-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--step-1);
  }

  .grouping-title :global(.icon) {
    color: var(--ink-muted);
  }

  .grouping-description {
    margin-block-start: var(--space-3);
    color: var(--ink-muted);
  }

  /* Pinned to the foot, so the two screenshots line up under uneven copy */
  .grouping-media {
    margin-block-start: auto;
    padding-block-start: var(--space-6);
  }

  @media (max-width: 700px) {
    .groupings {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
