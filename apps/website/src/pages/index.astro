---
import AppWindow from '../components/AppWindow.astro';
import DownloadButton from '../components/DownloadButton.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import FeatureTabs, {
  type TabbedFeature,
} from '../components/FeatureTabs.astro';
import Icon from '../components/Icon.astro';
import PageSection from '../components/PageSection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const databaseFeatures: TabbedFeature[] = [
  {
    id: 'properties',
    title: 'Properties',
    description:
      'Give every entry the same typed fields: text, dates, numbers, select options, files, and images.',
    icon: 'list',
  },
  {
    id: 'files',
    title: 'Choose your format',
    description:
      "Store a database's entries as Markdown, JSON, or YAML — Markdown by default, with properties in frontmatter.",
    icon: 'file-text',
  },
  {
    id: 'templates',
    title: 'Templates',
    description:
      'Start from a ready-made database, and add entry templates that pre-fill properties for new entries.',
    icon: 'copy',
  },
  {
    id: 'collections',
    title: 'Collections',
    description:
      'Curate a list by hand, gathering entries from any database into one place.',
    icon: 'bookmark',
  },
  {
    id: 'queries',
    title: 'Queries',
    description:
      'Filter and sort entries by rules, then save the result to come back to.',
    icon: 'filter',
  },
];
---

<BaseLayout
  title="MindDrop"
  description="Organise your projects, studies, research, and ideas into databases built from plain Markdown files."
>
  <section class="page hero">
    <h1 class="hero-title">Your mind's visual workspace</h1>

    <p class="hero-lede">
      Organise your projects, studies, research, and ideas into databases built
      from plain Markdown files.
    </p>

    <div class="hero-action">
      <DownloadButton />
    </div>

    <p class="hero-licence">
      MindDrop is free and <a href="https://github.com/coniel/minddrop"
        >open source</a
      >.
    </p>

    <div class="hero-principles">
      <FeatureGrid>
        <article class="principle">
          <h2 class="principle-title">
            <Icon name="database" />
            Databases
          </h2>

          <p class="principle-description">
            All your content lives in databases, where you define the properties
            every entry shares.
          </p>
        </article>

        <article class="principle">
          <h2 class="principle-title">
            <Icon name="file-text" />
            Plain files
          </h2>

          <p class="principle-description">
            Every entry is a plain Markdown file, stored in a folder on your
            computer and readable in any editor.
          </p>
        </article>

        <article class="principle">
          <h2 class="principle-title">
            <Icon name="palette" />
            Design studio
          </h2>

          <p class="principle-description">
            Give each database a unique design to match its content, built in a
            drag-and-drop design tool.
          </p>
        </article>
      </FeatureGrid>
    </div>

    <div class="hero-media">
      <AppWindow>
        {/* Placeholder until the hero screenshot is ready */}
        <div class="hero-media-placeholder"></div>
      </AppWindow>
    </div>
  </section>

  <PageSection
    id="databases"
    title="Databases"
    description="Everything you write lives in a database: a folder of entries that share the properties you define. The folder is a real folder on your disk, and each entry is a real file inside it."
  >
    <FeatureTabs name="databases" features={databaseFeatures} />
  </PageSection>
</BaseLayout>

<style>
  .hero {
    padding-block-start: var(--space-8);
    text-align: center;
  }

  .hero-title {
    font-size: var(--step-4);
  }

  .hero-lede {
    max-width: var(--measure);
    margin-block-start: var(--space-5);
    margin-inline: auto;
    font-size: var(--step-1);
    color: var(--ink-muted);
  }

  .hero-action {
    margin-block-start: var(--space-6);
  }

  .hero-licence {
    margin-block-start: var(--space-5);
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  /*
   * Paired with the gap above the licence line, so dropping that line lower
   * leaves the distance from button to cards unchanged.
   */
  .hero-principles {
    margin-block-start: calc(var(--space-8) - var(--space-3));
  }

  .principle {
    padding: var(--space-4);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
    text-align: start;
  }

  .principle-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--step-0);
  }

  .principle-title :global(.icon) {
    color: var(--ink-muted);
  }

  .principle-description {
    margin-block-start: var(--space-2);
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  /* The screenshot belongs with the blocks above it, so it sits close */
  .hero-media {
    margin-block-start: var(--space-6);
  }

  .hero-media-placeholder {
    aspect-ratio: 16 / 10;
    background: var(--paper-sunk);
  }
</style>
