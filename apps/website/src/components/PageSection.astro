---
/**
 * A landing page section: a heading, a paragraph explaining it, and whatever
 * shows it off below.
 */

interface Props {
  /**
   * The section's heading.
   */
  title: string;

  /**
   * One paragraph introducing the section, shown under the heading.
   */
  description: string;

  /**
   * Anchor id, so the header and in-page links can jump here.
   */
  id?: string;
}

const { title, description, id } = Astro.props;
---

<section class="page section" id={id}>
  <header class="section-header">
    <h2 class="section-title">{title}</h2>
    <p class="section-description">{description}</p>
  </header>

  <slot />
</section>

<style>
  .section {
    margin-block-start: var(--space-9);
  }

  .section-header {
    margin-block-end: var(--space-7);
  }

  .section-title {
    font-size: var(--step-3);
  }

  .section-description {
    max-width: var(--measure);
    margin-block-start: var(--space-4);
    font-size: var(--step-1);
    color: var(--ink-muted);
  }
</style>
