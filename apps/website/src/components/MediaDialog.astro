---
import AppWindow from './AppWindow.astro';
import Icon from './Icon.astro';

/**
 * A full-screen dialog showing one screenshot at a time, with chevrons either
 * side to step through the set.
 *
 * Opened by anything carrying `data-view-index` inside the same
 * `data-view-gallery` container. The behaviour lives in the base layout.
 */

export interface DialogItem {
  /**
   * Heading shown under the screenshot.
   */
  title: string;

  /**
   * One sentence shown under the heading.
   */
  description: string;

  /**
   * The screenshot. A placeholder is shown while it is missing.
   */
  image?: string;

  /**
   * Describes the screenshot for anyone who cannot see it.
   */
  imageAlt?: string;
}

interface Props {
  /**
   * Names the dialog for anyone who cannot see it, e.g. 'View types'.
   */
  label: string;

  /**
   * The screenshots to step through, in the order the openers use.
   */
  items: DialogItem[];
}

const { label, items } = Astro.props;
---

<dialog class="media-dialog" aria-label={label} data-view-dialog>
  {/* Fills the viewport so the chevrons can sit outside the panel */}
  <div class="media-dialog-layout" data-view-backdrop>
    <button
      class="media-dialog-step"
      type="button"
      aria-label="Previous"
      data-view-previous
    >
      <Icon name="chevron-left" />
    </button>

    <div class="media-dialog-panels">
      <button
        class="media-dialog-step media-dialog-close"
        type="button"
        aria-label="Close"
        data-view-close
      >
        <Icon name="x" />
      </button>

      {
        items.map((item, index) => (
          <div class="media-dialog-panel" hidden={index !== 0} data-view-panel>
            {item.image ? (
              <AppWindow>
                <img src={item.image} alt={item.imageAlt ?? ''} />
              </AppWindow>
            ) : (
              <AppWindow />
            )}

            <h3 class="media-dialog-title">{item.title}</h3>
            <p class="media-dialog-description">{item.description}</p>
          </div>
        ))
      }
    </div>

    <button
      class="media-dialog-step"
      type="button"
      aria-label="Next"
      data-view-next
    >
      <Icon name="chevron-right" />
    </button>
  </div>
</dialog>

<style>
  /*
   * The dialog is the whole viewport, the visible panel sits inside it. Sized
   * by inset rather than viewport units, which would count the scrollbar and
   * overflow.
   */
  .media-dialog {
    position: fixed;
    inset: 0;
    width: auto;
    max-width: none;
    height: auto;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
  }

  .media-dialog::backdrop {
    background: rgb(0 0 0 / 0.6);
  }

  .media-dialog-layout {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    width: 100%;
    min-height: 100%;
    padding: var(--space-5);
    /* A panel taller than the viewport scrolls rather than being cut off */
    overflow: auto;
  }

  /*
   * As wide as the viewport allows, up to a cap. The last term keeps the panel
   * short enough to fit vertically: it converts the height left over after the
   * padding and caption back into a width using the screenshot's 16:10 ratio.
   */
  .media-dialog-panels {
    position: relative;
    width: min(80rem, 100%, calc((100dvh - 210px) * 1.6));
    padding: var(--space-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius-xl);
    background: var(--paper);
  }

  /* Drawn against the backdrop rather than the page, so it is light */
  .media-dialog-step {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: var(--radius-full);
    background: rgb(255 255 255 / 0.12);
    color: #ffffff;
    transition: var(--transition-colors);
  }

  .media-dialog-step:hover {
    background: rgb(255 255 255 / 0.22);
  }

  .media-dialog-step :global(.icon) {
    width: 1.5rem;
    height: 1.5rem;
  }

  /*
   * Sits in the same column as the next chevron, one gap to the right of the
   * panel, with its top on the panel's top edge.
   */
  .media-dialog-close {
    position: absolute;
    top: 0;
    left: calc(100% + var(--space-4));
  }

  .media-dialog-title {
    margin-block-start: var(--space-5);
    font-size: var(--step-2);
  }

  .media-dialog-description {
    margin-block-start: var(--space-2);
    color: var(--ink-muted);
  }

  /* The chevrons have to give up room before the panel does */
  @media (max-width: 700px) {
    .media-dialog-layout {
      gap: var(--space-2);
      padding: var(--space-3);
    }

    .media-dialog-step {
      width: 2.25rem;
      height: 2.25rem;
    }

    .media-dialog-step :global(.icon) {
      width: 1.25rem;
      height: 1.25rem;
    }

    .media-dialog-close {
      left: calc(100% + var(--space-2));
    }
  }
</style>
