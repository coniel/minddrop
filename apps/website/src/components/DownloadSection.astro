---
import { downloads } from '../downloads';

/**
 * The page's closing call to action: one button per platform.
 *
 * The reader's own platform is filled in by the script in the base layout,
 * since a static page cannot know it up front.
 */
---

<section class="page download" id="download">
  <div class="download-panel">
    <h2 class="download-title">Get MindDrop</h2>

    <p class="download-description">
      Free and open source. No account or internet connection needed.
    </p>

    <div class="download-options">
      {
        downloads.map((download) => (
          <a
            class="button download-option"
            href={download.href}
            data-download-platform={download.platform}
          >
            {download.name}
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  /*
   * The panel carries its own heading rather than sitting under a section
   * title, so a rule stands in for the break the other sections get.
   */
  .download {
    margin-block-start: var(--space-9);
  }

  .download::before {
    content: '';
    display: block;
    height: 1px;
    margin-block-end: var(--space-9);
    background: var(--rule);
  }

  /* Lit from above, the content below it being centred */
  .download-panel {
    padding: var(--space-8) var(--gutter);
    border: 1px solid color-mix(in srgb, var(--accent) 20%, var(--rule));
    border-radius: var(--radius-xl);
    background:
      radial-gradient(
        90% 120% at 50% 0%,
        color-mix(in srgb, var(--accent) 12%, transparent),
        transparent 65%
      ),
      var(--paper-sunk);
    text-align: center;
  }

  .download-title {
    font-size: var(--step-3);
  }

  .download-description {
    max-width: var(--measure);
    margin-block-start: var(--space-4);
    margin-inline: auto;
    font-size: var(--step-1);
    color: var(--ink-muted);
  }

  .download-options {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
  }

  /* Bordered rather than ghost, so each platform reads as an option */
  .download-option {
    border-color: var(--rule);
    color: var(--ink);
  }

  .download-option:hover {
    background: var(--surface-hover);
  }

  .download-option:active {
    background: var(--surface-active);
  }

  /* The reader's own platform, marked as the one to take */
  .download-option[data-os-current] {
    background: var(--accent-solid);
    border-color: var(--accent-solid);
    color: #ffffff;
  }

  .download-option[data-os-current]:hover {
    background: var(--accent-solid-hover);
    border-color: var(--accent-solid-hover);
  }
</style>
