---
import ThemeToggle from './ThemeToggle.astro';

const { pathname } = Astro.url;

const links = [
  { href: '/pricing', label: 'Pricing' },
  { href: '/pro', label: 'Pro' },
  { href: '/blog', label: 'Blog' },
  { href: '/changelog', label: 'Changelog' },
];

/**
 * Marks a nav link as current when the page sits under it, so a post page
 * still highlights Blog.
 */
function isCurrent(href: string): boolean {
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header class="site-header">
  {/* Balances the toggle opposite it, so the bar's content stays centred */}
  <div class="site-header-side" aria-hidden="true"></div>

  <div class="page site-header-inner">
    <a class="site-header-wordmark" href="/">
      <img
        class="site-header-logo"
        src="/logo.svg"
        alt=""
        width="118"
        height="118"
      />
      MindDrop
    </a>

    <nav class="site-header-nav" aria-label="Main">
      {
        links.map((link) => (
          <a
            class="button button-ghost"
            href={link.href}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }

      <a class="button button-primary site-header-download" href="/#download">
        Download
      </a>
    </nav>
  </div>

  <div class="site-header-side">
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    border-block-end: 1px solid var(--rule);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
  }

  /*
   * The toggle sits at the edge of the bar rather than with the content. The
   * width matches the toggle's, so the empty side balances the one holding it.
   */
  .site-header-side {
    display: flex;
    flex: none;
    align-items: center;
    width: 2rem;
    box-sizing: content-box;
    padding-inline: var(--space-4);
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block: var(--space-3);
  }

  .site-header-wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-ui);
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }

  .site-header-wordmark:hover {
    text-decoration: none;
  }

  .site-header-logo {
    width: 1.5em;
    height: 1.5em;
  }

  .site-header-nav {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  /* The current page reads as selected rather than merely hovered */
  .site-header-nav .button-ghost[aria-current='page'] {
    color: var(--ink);
  }

  /* The download button sits apart from the quiet controls beside it */
  .site-header-download {
    margin-inline-start: var(--space-3);
  }

  /*
   * On a phone the bar cannot hold everything, so the quiet links give way
   * rather than the download button. Both are still listed in the footer.
   */
  @media (max-width: 560px) {
    .site-header-nav .button-ghost {
      display: none;
    }

    .site-header-download {
      margin-inline-start: 0;
    }

    /* The edges give back what they can, the bar being short of room */
    .site-header-side {
      padding-inline: var(--space-2);
    }
  }
</style>
