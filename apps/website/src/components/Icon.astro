---
/**
 * Renders one of the site's icons, drawn from the Lucide set the app uses.
 *
 * Paths live here rather than in each caller so the same mark is never
 * duplicated across sections.
 */

export type IconName =
  | 'accessibility'
  | 'bar-chart'
  | 'blocks'
  | 'bookmark'
  | 'check'
  | 'chevron-left'
  | 'chevron-right'
  | 'cloud'
  | 'copy'
  | 'database'
  | 'file-text'
  | 'filter'
  | 'globe'
  | 'history'
  | 'inbox'
  | 'refresh'
  | 'layout-template'
  | 'list'
  | 'lock'
  | 'palette'
  | 'search'
  | 'shield'
  | 'sliders'
  | 'x';

interface Props {
  /**
   * Which icon to draw.
   */
  name: IconName;
}

const { name } = Astro.props;
---

<svg
  class="icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'database' && (
      <Fragment>
        <ellipse cx="12" cy="5" rx="9" ry="3" />
        <path d="M3 5v14a9 3 0 0 0 18 0V5" />
        <path d="M3 12a9 3 0 0 0 18 0" />
      </Fragment>
    )
  }

  {
    name === 'file-text' && (
      <Fragment>
        <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
        <path d="M14 2v4a2 2 0 0 0 2 2h4" />
        <path d="M16 13H8" />
        <path d="M16 17H8" />
      </Fragment>
    )
  }

  {
    name === 'palette' && (
      <Fragment>
        <circle cx="13.5" cy="6.5" r=".5" fill="currentColor" />
        <circle cx="17.5" cy="10.5" r=".5" fill="currentColor" />
        <circle cx="8.5" cy="7.5" r=".5" fill="currentColor" />
        <circle cx="6.5" cy="12.5" r=".5" fill="currentColor" />
        <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z" />
      </Fragment>
    )
  }

  {
    name === 'list' && (
      <Fragment>
        <path d="M3 6h.01" />
        <path d="M3 12h.01" />
        <path d="M3 18h.01" />
        <path d="M8 6h13" />
        <path d="M8 12h13" />
        <path d="M8 18h13" />
      </Fragment>
    )
  }

  {
    name === 'copy' && (
      <Fragment>
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
      </Fragment>
    )
  }

  {
    name === 'bookmark' && (
      <path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
    )
  }

  {
    name === 'filter' && (
      <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
    )
  }

  {name === 'check' && <path d="M20 6 9 17l-5-5" />}

  {name === 'chevron-left' && <path d="m15 18-6-6 6-6" />}

  {name === 'chevron-right' && <path d="m9 18 6-6-6-6" />}

  {
    name === 'x' && (
      <Fragment>
        <path d="M18 6 6 18" />
        <path d="m6 6 12 12" />
      </Fragment>
    )
  }

  {
    name === 'lock' && (
      <Fragment>
        <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
      </Fragment>
    )
  }

  {
    name === 'history' && (
      <Fragment>
        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
        <path d="M3 3v5h5" />
        <path d="M12 7v5l4 2" />
      </Fragment>
    )
  }

  {
    name === 'search' && (
      <Fragment>
        <circle cx="11" cy="11" r="8" />
        <path d="m21 21-4.3-4.3" />
      </Fragment>
    )
  }

  {
    name === 'shield' && (
      <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
    )
  }

  {
    name === 'sliders' && (
      <Fragment>
        <path d="M21 4h-7" />
        <path d="M10 4H3" />
        <path d="M21 12h-9" />
        <path d="M8 12H3" />
        <path d="M21 20h-5" />
        <path d="M12 20H3" />
        <path d="M14 2v4" />
        <path d="M8 10v4" />
        <path d="M16 18v4" />
      </Fragment>
    )
  }

  {
    name === 'cloud' && (
      <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" />
    )
  }

  {
    name === 'globe' && (
      <Fragment>
        <circle cx="12" cy="12" r="10" />
        <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
        <path d="M2 12h20" />
      </Fragment>
    )
  }

  {
    name === 'accessibility' && (
      <Fragment>
        <circle cx="16" cy="4" r="1" />
        <path d="m18 19 1-7-6 1" />
        <path d="m5 8 3-3 5.5 3-2.36 3.5" />
        <path d="M4.24 14.5a5 5 0 0 0 6.88 6" />
        <path d="M13.76 17.5a5 5 0 0 0-6.88-6" />
      </Fragment>
    )
  }

  {
    name === 'refresh' && (
      <Fragment>
        <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" />
        <path d="M21 3v5h-5" />
        <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" />
        <path d="M8 16H3v5" />
      </Fragment>
    )
  }

  {
    name === 'bar-chart' && (
      <Fragment>
        <path d="M3 3v16a2 2 0 0 0 2 2h16" />
        <path d="M18 17V9" />
        <path d="M13 17V5" />
        <path d="M8 17v-3" />
      </Fragment>
    )
  }

  {
    name === 'blocks' && (
      <Fragment>
        <rect width="7" height="7" x="14" y="3" rx="1" />
        <path d="M10 21V8a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-5a1 1 0 0 0-1-1H3" />
      </Fragment>
    )
  }

  {
    name === 'inbox' && (
      <Fragment>
        <polyline points="22 12 16 12 14 15 10 15 8 12 2 12" />
        <path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z" />
      </Fragment>
    )
  }

  {
    name === 'layout-template' && (
      <Fragment>
        <rect width="18" height="7" x="3" y="3" rx="1" />
        <rect width="9" height="7" x="3" y="14" rx="1" />
        <rect width="5" height="7" x="16" y="14" rx="1" />
      </Fragment>
    )
  }
</svg>

<style>
  .icon {
    width: 1.125em;
    height: 1.125em;
    flex-shrink: 0;
  }
</style>
