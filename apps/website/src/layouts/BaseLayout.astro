---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';

interface Props {
  /**
   * Page title, shown in the browser tab and as the social card title.
   */
  title: string;

  /**
   * Page description, used for the meta description and social card.
   */
  description?: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="MindDrop Blog"
      href="/rss.xml"
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      // Apply a stored theme choice before the first paint, otherwise the page
      // renders in the system theme and then flips
      try {
        const stored = localStorage.getItem('theme');

        if (stored === 'light' || stored === 'dark') {
          document.documentElement.dataset.theme = stored;
        }
      } catch {
        // Storage is unavailable, fall back to the system preference
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>

    <SiteHeader />
    {/* Focusable, so following the skip link moves the keyboard here */}
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />

    <script is:inline>
      // Let a view gallery open any of its screenshots in a dialog and step
      // between them. Without this the cards are inert.
      document.querySelectorAll('[data-view-gallery]').forEach((gallery) => {
        const dialog = gallery.querySelector('[data-view-dialog]');
        const panels = Array.from(
          gallery.querySelectorAll('[data-view-panel]'),
        );
        const cards = Array.from(gallery.querySelectorAll('[data-view-index]'));

        // Nothing to open
        if (!dialog || panels.length === 0) {
          return;
        }

        // Present when the gallery also shows the set on the page behind it
        const tabs = Array.from(gallery.querySelectorAll('[role="tab"]'));
        const hasMatchingTabs = tabs.length === panels.length;

        let current = 0;

        function show(index) {
          current = (index + panels.length) % panels.length;

          panels.forEach((panel, position) => {
            panel.hidden = position !== current;
          });

          // Move the page behind the dialog along, so closing it agrees
          if (hasMatchingTabs) {
            tabs[current].click();
          }
        }

        cards.forEach((card) => {
          card.addEventListener('click', () => {
            show(Number(card.dataset.viewIndex));
            dialog.showModal();

            // Stop the page behind the dialog scrolling with the wheel
            document.documentElement.style.overflow = 'hidden';
          });
        });

        dialog.addEventListener('close', () => {
          document.documentElement.style.overflow = '';
        });

        dialog
          .querySelector('[data-view-previous]')
          .addEventListener('click', () => show(current - 1));

        dialog
          .querySelector('[data-view-next]')
          .addEventListener('click', () => show(current + 1));

        dialog
          .querySelector('[data-view-close]')
          .addEventListener('click', () => dialog.close());

        // Arrow keys step through, matching the previous and next buttons
        dialog.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowRight') {
            show(current + 1);
          }

          if (event.key === 'ArrowLeft') {
            show(current - 1);
          }
        });

        // The layout fills the dialog, so empty space around the panel is it
        dialog.addEventListener('click', (event) => {
          if (
            event.target === dialog ||
            event.target.hasAttribute('data-view-backdrop')
          ) {
            dialog.close();
          }
        });
      });
    </script>

    <script is:inline>
      // Let each set of feature cards swap the screenshot beside it. Without
      // this the first feature's screenshot is the one on show.
      document.querySelectorAll('[data-feature-tabs]').forEach((set) => {
        const tabs = Array.from(set.querySelectorAll('[role="tab"]'));
        const previous = set.querySelector('[data-tabs-previous]');
        const next = set.querySelector('[data-tabs-next]');

        let current = 0;

        function select(index) {
          current = (index + tabs.length) % tabs.length;

          tabs.forEach((tab, position) => {
            const isSelected = position === current;

            tab.setAttribute('aria-selected', String(isSelected));
            tab.tabIndex = isSelected ? 0 : -1;

            const panel = document.getElementById(
              tab.getAttribute('aria-controls'),
            );

            if (panel) {
              panel.hidden = !isSelected;
            }
          });

          reveal(tabs[current]);
        }

        /*
         * Where a card sits along the scroller's own scrolling axis. Measured
         * from the rendered boxes, because offsetLeft is relative to whichever
         * ancestor happens to be positioned, not to the scroller.
         */
        function offsetOf(scroller, element) {
          return (
            scroller.scrollLeft +
            element.getBoundingClientRect().left -
            scroller.getBoundingClientRect().left -
            scroller.clientLeft
          );
        }

        /*
         * Scroll the least distance that brings the selected card fully into
         * view, always resting on a card's leading edge. Stopping mid-card
         * would leave the scroll snapping to correct the position afterwards.
         */
        function reveal(tab) {
          const scroller = tab.parentElement;

          // The row fits, so there is nothing to scroll
          if (scroller.scrollWidth <= scroller.clientWidth) {
            return;
          }

          const starts = tabs.map((item) => offsetOf(scroller, item));
          const start = starts[tabs.indexOf(tab)];
          const end = start + tab.offsetWidth;
          const viewportEnd = scroller.scrollLeft + scroller.clientWidth;

          // Already on screen, so leave the row where the reader put it
          if (start >= scroller.scrollLeft - 1 && end <= viewportEnd + 1) {
            return;
          }

          const scrollingBack = start < scroller.scrollLeft;

          // Going forward, stop at the first card that still reveals this one
          const target = scrollingBack
            ? start
            : (starts.find(
                (candidate) => end <= candidate + scroller.clientWidth,
              ) ?? start);

          scroller.scrollTo({
            left: Math.min(target, scroller.scrollWidth - scroller.clientWidth),
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)')
              .matches
              ? 'auto'
              : 'smooth',
          });
        }

        if (previous) {
          previous.addEventListener('click', () => select(current - 1));
        }

        if (next) {
          next.addEventListener('click', () => select(current + 1));
        }

        tabs.forEach((tab, index) => {
          tab.addEventListener('click', () => select(index));

          tab.addEventListener('keydown', (event) => {
            const step = getStep(event.key);

            // Not a key that moves between cards
            if (step === null) {
              return;
            }

            event.preventDefault();

            const target = (index + step + tabs.length) % tabs.length;

            select(target);
            tabs[target].focus();
          });
        });
      });

      // How far the pressed key moves the selection, or null if it does not
      function getStep(key) {
        if (key === 'ArrowDown' || key === 'ArrowRight') {
          return 1;
        }

        if (key === 'ArrowUp' || key === 'ArrowLeft') {
          return -1;
        }

        return null;
      }
    </script>

    <script is:inline>
      // Point the page at the reader's platform. It ships generic, because a
      // static page cannot know the platform until it runs.
      (() => {
        const platform = getPlatform();

        // An unrecognised or mobile platform keeps the generic label and the
        // full list of builds, since there is none to single out
        if (!platform) {
          return;
        }

        const names = { mac: 'Mac', windows: 'Windows', linux: 'Linux' };

        // Name every download button for the platform
        document.querySelectorAll('[data-os-label]').forEach((label) => {
          label.textContent = `Download for ${names[platform]}`;
        });

        // Mark this platform's build as the one to take
        document
          .querySelectorAll(`[data-download-platform="${platform}"]`)
          .forEach((option) => {
            option.dataset.osCurrent = '';
          });

        // Which platform the reader is on, or null if there is no build for it
        function getPlatform() {
          const agent = navigator.userAgent;

          // iPadOS reports itself as a Mac, so check the touch points too
          const isIpad =
            /iPad/.test(agent) ||
            (/Macintosh/.test(agent) && navigator.maxTouchPoints > 1);

          if (isIpad || /Android|iPhone|iPod/.test(agent)) {
            return null;
          }

          if (/Mac/.test(agent)) {
            return 'mac';
          }

          if (/Win/.test(agent)) {
            return 'windows';
          }

          if (/Linux|X11/.test(agent)) {
            return 'linux';
          }

          return null;
        }
      })();
    </script>
  </body>
</html>
